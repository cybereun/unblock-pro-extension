{
  "manifest_version": 3,
  "name": "Unblock Pro - 웹 접근성 및 우클릭 복원",
  "version": "1.1.0",
  "description": "브라우저 기본 우클릭 메뉴와 텍스트 선택 기능을 복원하여 웹 브라우징 접근성과 편의성을 높여줍니다.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "클릭하여 우클릭 복원 기능 ON/OFF 전환",
    "default_icon": {
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "128": "icons/icon128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+R",
        "mac": "Alt+R"
      },
      "description": "우클릭 복원 기능 토글"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content_isolated.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "inject_main.js",
        "unblock.css"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
